# Copy to .env and adjust. .env is gitignored.

# Chat model — MUST support tool-calling (e.g. qwen2.5, llama3.1).
# No default anywhere in code; this is the single source of truth.
OLLAMA_MODEL=qwen2.5

# Embedding model for RAG.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ollama API base URL.
OLLAMA_HOST=http://localhost:11434

# --- Phases 19–26 (all optional) ---------------------------------------------

# Web tools (web_search / fetch_url). Set to false for a fully offline posture.
ENABLE_WEB_TOOLS=true

# Optional self-hosted SearXNG for robust web search (DuckDuckGo rate-limits).
# SEARXNG_URL=http://localhost:8080

# Where vault.py archives model manifests + blobs (external drive, NAS...).
# MODEL_VAULT_DIR=~/model-vault

# Ollama's model store, if you moved it (same variable the Ollama server reads).
# OLLAMA_MODELS=~/.ollama/models
